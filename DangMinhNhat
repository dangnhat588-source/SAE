local startTime = tick()
task.spawn(function()
    local colorHue = 0
    while true do
        colorHue = colorHue + 0.01
        if colorHue > 1 then colorHue = 0 end
        local rainbowColor = Color3.fromHSV(colorHue, 1, 1)
        fpsLabel.TextColor3 = rainbowColor
        timeLabel.TextColor3 = rainbowColor
        RunService.RenderStepped:Wait()
    end
end)

local currentTopPetText = "Đang tìm..."
task.spawn(function()
    while task.wait(1) do
        if isSystemOn then
            if scrollingFrame then
                local maxMoney = -1
                local topPetText = "Không tìm thấy"

                for _, pet in ipairs(scrollingFrame:GetChildren()) do
                    local mainFrame = pet:FindFirstChild("Main_Frame") or pet:FindFirstChild("Frame") or pet
                    local targetLabel = mainFrame:FindFirstChildWhichIsA("TextLabel", true)
                    
                    if targetLabel then
                        local moneyValue = parseMoneyString(targetLabel.Text)
                        if moneyValue > maxMoney then
                            maxMoney = moneyValue
                            topPetText = extractMoneyOnly(targetLabel.Text)
                            
                            local petImg = mainFrame:FindFirstChildWhichIsA("ImageLabel", true)
                            if petImg then
                                topPetIcon.Image = petImg.Image
                                topPetIcon.Visible = true
                            end
                        end
                    end
                end
                currentTopPetText = topPetText
            else
                currentTopPetText = "N/A"
            end
        end
    end
end)

local frameCount, lastUpdate = 0, tick()
RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1
    local now = tick()
    if now - lastUpdate >= 1 then
        fpsLabel.Text = string.format("FPS: %d", math.floor(frameCount / (now - lastUpdate)))
        frameCount = 0
        lastUpdate = now
    end

    if not isSystemOn then return end

    nameLabel.Text = LocalPlayer.Name

    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    local speedObj = leaderstats and leaderstats:FindFirstChild("Speed")
    if speedObj then
        speedLabel.Text = tostring(speedObj.Value)
    else
        speedLabel.Text = "N/A"
    end

    local successMoney, moneyVal = pcall(function()
        return LocalPlayer.PlayerGui.HUD.GameHUD.BottomLeft.Money.Text
    end)
    if not successMoney or not moneyVal then
        pcall(function()
            moneyVal = LocalPlayer.PlayerGui.HUD.GameHUD.BottomLeft.Money.Value.Text
        end)
    end
    moneyLabel.Text = tostring(moneyVal or "N/A")

    topPetLabel.Text = currentTopPetText

    local elapsed = tick() - startTime
    timeLabel.Text = formatTime(elapsed)
end)

