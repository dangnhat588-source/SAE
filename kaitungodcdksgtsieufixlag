local function processCharacter(model)
	if not model then return end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end

	for _, child in ipairs(model:GetChildren()) do
		if child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic") or child:IsA("Clothing") or child:IsA("BodyColors") then
			child:Destroy()
		elseif child:IsA("Accessory") or child:IsA("Accoutrement") then
			child:Destroy()
		elseif child.Name == "Head" then
			for _, headChild in ipairs(child:GetChildren()) do
				if headChild:IsA("Decal") then
					headChild:Destroy()
				end
			end
		end
	end

	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Color = CHARACTER_COLOR
			part.Material = Enum.Material.SmoothPlastic
			part.Reflectance = 0
			part.CastShadow = false
			if part:IsA("MeshPart") then
				part.TextureID = ""
			end
		end
	end
end

local function cleanInstance(inst)
	if not inst or not inst.Parent then return end
	
	if inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") then
		processCharacter(inst)
		return
	end

	if inst:IsA("ParticleEmitter") 
		or inst:IsA("Trail") 
		or inst:IsA("Beam") 
		or inst:IsA("Fire") 
		or inst:IsA("Smoke") 
		or inst:IsA("Sparkles") 
		or inst:IsA("Highlight") 
		or inst:IsA("Light") then
		
		inst:Destroy()

	elseif inst:IsA("Decal") or inst:IsA("Texture") then
		if not inst:IsDescendantOf(Workspace) or not inst:FindFirstAncestorOfClass("Model") or not inst:FindFirstAncestorOfClass("Model"):FindFirstChildOfClass("Humanoid") then
			inst.Texture = ""
			inst:Destroy()
		end
	elseif inst:IsA("BasePart") and not (inst.Parent and inst.Parent:FindFirstChildOfClass("Humanoid")) then
		inst.Material = Enum.Material.SmoothPlastic
		inst.Reflectance = 0
		inst.CastShadow = false
	elseif inst:IsA("MeshPart") and not (inst.Parent and inst.Parent:FindFirstChildOfClass("Humanoid")) then
		inst.Material = Enum.Material.SmoothPlastic
		inst.Reflectance = 0
		inst.CastShadow = false
		inst.TextureID = ""
	end
end

for _, item in ipairs(Workspace:GetChildren()) do
	if item:IsA("Model") and item:FindFirstChildOfClass("Humanoid") then
		processCharacter(item)
	end
end

for _, item in ipairs(Workspace:GetDescendants()) do
	cleanInstance(item)
end

Workspace.DescendantAdded:Connect(function(child)
	cleanInstance(child)
	if child:IsA("Model") and child:FindFirstChildOfClass("Humanoid") then
		processCharacter(child)
	elseif child.Parent and child.Parent:IsA("Model") and child.Parent:FindFirstChildOfClass("Humanoid") then
		processCharacter(child.Parent)
	end
end)

if Workspace.CurrentCamera then
	Workspace.CurrentCamera.DescendantAdded:Connect(function(child)
		cleanInstance(child)
	end)
end

