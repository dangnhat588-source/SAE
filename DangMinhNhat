local isSystemOn = true

local function formatTime(seconds)
    local hours = math.floor(seconds / 3600)
    local mins = math.floor((seconds % 3600) / 60)
    local secs = math.floor(seconds % 60)
    return string.format("%02d:%02d:%02d", hours, mins, secs)
end

local function parseMoneyString(text)
    if not text then return 0 end
    local moneyStr = string.match(text, "%((.-)%)") or text
    moneyStr = string.gsub(moneyStr, "[%$/s%s]", "")

    local number = tonumber(string.match(moneyStr, "^[%d%.]+"))
    if not number then return 0 end

    local suffix = string.match(moneyStr, "%a+$")
    if suffix then
        suffix = string.upper(suffix)
        if suffix == "K" then number = number * 1e3
        elseif suffix == "M" then number = number * 1e6
        elseif suffix == "B" then number = number * 1e9
        elseif suffix == "T" then number = number * 1e12
        elseif suffix == "QA" then number = number * 1e15
        elseif suffix == "QI" then number = number * 1e18
        end
    end
    return number
end

local function extractMoneyOnly(rawText)
    if not rawText then return "N/A" end
    local moneyOnly = string.match(rawText, "(%$[%d%.]+%a*/s)") or string.match(rawText, "(%$[%d%.]+%a*)") or string.match(rawText, "([%d%.]+%a*/s)")
    return moneyOnly or rawText
end

