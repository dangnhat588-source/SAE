-- 1. XỬ LÝ LỌC PLOTS VÀ CLIENT RENDERED ASSETS
-- ==========================================
local plotsFolder = workspace:FindFirstChild("Plots")
local clientAssets = workspace:FindFirstChild("ClientRenderedAssets")
local myPlot = nil

if plotsFolder then
    for _, plot in ipairs(plotsFolder:GetChildren()) do
        local playerNameObj = plot:FindFirstChild("PlotSign")
            and plot.PlotSign:FindFirstChild("PlayerPlotSign")
            and plot.PlotSign.PlayerPlotSign:FindFirstChild("Frame")
            and plot.PlotSign.PlayerPlotSign.Frame:FindFirstChild("PlayerName")

        if playerNameObj then
            local ownerName = (playerNameObj:IsA("TextLabel") or playerNameObj:IsA("TextBox")) 
                and playerNameObj.Text 
                or tostring(playerNameObj.Value)

            if ownerName == LocalPlayer.Name or ownerName == LocalPlayer.DisplayName then
                myPlot = plot
            else
                plot:Destroy()
            end
        else
            plot:Destroy()
        end
    end
end

if clientAssets and myPlot then
    local function getAssetPosition(asset)
        if asset:IsA("Model") then
            return asset:GetPivot().Position
        elseif asset:IsA("BasePart") then
            return asset.Position
        end
        return nil
    end

    local function isInsidePlot(position, plot)
        local cf, size = plot:GetBoundingBox()
        local localPos = cf:PointToObjectSpace(position)
        return math.abs(localPos.X) <= size.X / 2
           and math.abs(localPos.Y) <= size.Y / 2
           and math.abs(localPos.Z) <= size.Z / 2
    end

    for _, asset in ipairs(clientAssets:GetChildren()) do
        local assetPos = getAssetPosition(asset)
        if assetPos then
            if not isInsidePlot(assetPos, myPlot) then
                asset:Destroy()
            end
        else
            asset:Destroy()
        end
    end
end

