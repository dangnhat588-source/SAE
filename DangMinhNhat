-- Hiệu ứng chữ cầu vồng (Luôn chạy cho FPS)
local startTime = tick()
task.spawn(function()
    local colorHue = 0
    while true do
        colorHue = colorHue + 0.01
        if colorHue > 1 then colorHue = 0 end
        local rainbowColor = Color3.fromHSV(colorHue, 1, 1)
        fpsLabel.TextColor3 = rainbowColor
        timeLabel.TextColor3 = rainbowColor
        RunService.RenderStepped:Wait()
    end
end)

-- Lấy Pet có số tiền cao nhất (Chỉ lấy chuỗi tiền)
local currentTopPetText = "Đang tìm..."
task.spawn(function()
    while task.wait(1) do
        if isSystemOn then
            if scrollingFrame then
                local maxMoney = -1
                local topPetText = "Không tìm thấy"

                for _, pet in ipairs(scrollingFrame:GetChildren()) do
                    local mainFrame = pet:FindFirstChild("Main_Frame")
                    if mainFrame then
                        local outerTextLabel = mainFrame:FindFirstChild("TextLabel")
                        if outerTextLabel then
                            local targetLabel = outerTextLabel:FindFirstChild("TextLabel")
                            if targetLabel and targetLabel:IsA("TextLabel") then
                                local moneyValue = parseMoneyString(targetLabel.Text)
                                if moneyValue > maxMoney then
                                    maxMoney = moneyValue
                                    topPetText = extractMoneyOnly(targetLabel.Text)
                                end
                            end
                        end
                    end
                end
                currentTopPetText = topPetText
            else
                currentTopPetText = "N/A"
            end
        end
    end
end)

-- Vòng lặp cập nhật thông tin hiển thị
local frameCount, lastUpdate = 0, tick()
RunService.RenderStepped:Connect(function()
    -- Cập nhật FPS bất kể ON hay OFF
    frameCount = frameCount + 1
    local now = tick()
    if now - lastUpdate >= 1 then
        fpsLabel.Text = string.format("FPS: %d", math.floor(frameCount / (now - lastUpdate)))
        frameCount = 0
        lastUpdate = now
    end

    if not isSystemOn then return end

    nameLabel.Text = LocalPlayer.Name

    local successSpeed, speedVal = pcall(function()
        return LocalPlayer.PlayerGui.Money.Bottom.Frame.SpeedValue.CurrentBoost.Text
    end)
    speedLabel.Text = "Speed: " .. (successSpeed and tostring(speedVal) or "N/A")

    local successMoney, moneyVal = pcall(function()
        return LocalPlayer.PlayerGui.Money.Bottom.Frame.Money.Money.Shadow.Text
    end)
    moneyLabel.Text = "Money: " .. (successMoney and tostring(moneyVal) or "N/A")

    topPetLabel.Text = currentTopPetText

    local elapsed = tick() - startTime
    timeLabel.Text = formatTime(elapsed)
end)

