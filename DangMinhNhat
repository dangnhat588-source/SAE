local function formatTime(seconds)
    local hours = math.floor(seconds / 3600)
    local mins = math.floor((seconds % 3600) / 60)
    local secs = math.floor(seconds % 60)
    return string.format("%02d:%02d:%02d", hours, mins, secs)
end

local function parseMoneyString(text)
    if not text then return 0 end
    local moneyStr = string.match(text, "%((.-)%)") or text
    moneyStr = string.gsub(moneyStr, "[%$/s%s]", "")

    local number = tonumber(string.match(moneyStr, "^[%d%.]+"))
    if not number then return 0 end

    local suffix = string.match(moneyStr, "%a+$")
    if suffix then
        suffix = string.upper(suffix)
        if suffix == "K" then number = number * 1e3
        elseif suffix == "M" then number = number * 1e6
        elseif suffix == "B" then number = number * 1e9
        elseif suffix == "T" then number = number * 1e12
        elseif suffix == "QA" then number = number * 1e15
        elseif suffix == "QI" then number = number * 1e18
        end
    end
    return number
end

local function extractMoneyOnly(rawText)
    if not rawText then return "N/A" end
    local moneyOnly = string.match(rawText, "(%$[%d%.]+%a*/s)") or string.match(rawText, "(%$[%d%.]+%a*)") or string.match(rawText, "([%d%.]+%a*/s)")
    return moneyOnly or rawText
end

local function updateIconImage(imgLabel, iconObj)
    if iconObj then
        local imgId = ""
        if (iconObj:IsA("ImageLabel") or iconObj:IsA("ImageButton")) and iconObj.Image ~= "" then
            imgId = iconObj.Image
        elseif (iconObj:IsA("Decal") or iconObj:IsA("Texture")) and iconObj.Texture ~= "" then
            imgId = iconObj.Texture
        end

        if imgId ~= "" then
            imgLabel.Image = imgId
            imgLabel.Visible = true
            return true
        end
    end
    imgLabel.Visible = false
    return false
end

local function getPetScrollingFrame()
    local success, sf = pcall(function()
        return LocalPlayer.PlayerGui.ActivePets.Frame.ScrollingFrame
    end)
    if success and sf then return sf end

    success, sf = pcall(function()
        return LocalPlayer.PlayerGui.HUD.ActivePets.Frame.ScrollingFrame
    end)
    if success and sf then return sf end

    return nil
end

local startTime = tick()
task.spawn(function()
    local colorHue = 0
    while true do
        colorHue = colorHue + 0.01
        if colorHue > 1 then colorHue = 0 end
        local rainbowColor = Color3.fromHSV(colorHue, 1, 1)
        fpsLabel.TextColor3 = rainbowColor
        timeLabel.TextColor3 = rainbowColor
        RunService.RenderStepped:Wait()
    end
end)

local currentTopPetText = "Đang tìm..."
local currentTopPetIconObj = nil

task.spawn(function()
    while task.wait(1) do
        if isSystemOn then
            local scrollingFrame = getPetScrollingFrame()
            if scrollingFrame then
                local maxMoney = -1
                local topPetText = "Không tìm thấy"
                local foundIcon = nil

                for _, pet in ipairs(scrollingFrame:GetChildren()) do
                    if pet:IsA("GuiObject") then
                        local targetLabel = pet:FindFirstChildWhichIsA("TextLabel", true)
                        local petIconObj = pet:FindFirstChild("Icon") or pet:FindFirstChildWhichIsA("ImageLabel", true)

                        if targetLabel then
                            local moneyValue = parseMoneyString(targetLabel.Text)
                            if moneyValue > maxMoney then
                                maxMoney = moneyValue
                                topPetText = extractMoneyOnly(targetLabel.Text)
                                foundIcon = petIconObj
                            end
                        end
                    end
                end
                currentTopPetText = topPetText
                currentTopPetIconObj = foundIcon
            else
                currentTopPetText = "N/A"
                currentTopPetIconObj = nil
            end
        end
    end
end)

local frameCount, lastUpdate = 0, tick()
RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1
    local now = tick()
    if now - lastUpdate >= 1 then
        fpsLabel.Text = string.format("FPS: %d", math.floor(frameCount / (now - lastUpdate)))
        frameCount = 0
        lastUpdate = now
    end

    if not isSystemOn then return end

    nameLabel.Text = LocalPlayer.Name

    local speedValText = "N/A"
    pcall(function()
        local speedObj = LocalPlayer.PlayerGui.HUD.GameHUD.BottomLeft.Speed
        local hasIcon = updateIconImage(speedIcon, speedObj:FindFirstChild("Icon"))
        
        local valObj = speedObj:FindFirstChild("Value")
        if valObj then
            speedValText = valObj:IsA("TextLabel") and valObj.Text or tostring(valObj.Value)
        end
        
        speedLabel.Text = (hasIcon and ": " or "") .. speedValText
    end)

    local moneyValText = "N/A"
    pcall(function()
        local moneyObj = LocalPlayer.PlayerGui.HUD.GameHUD.BottomLeft.Money
        local hasIcon = updateIconImage(moneyIcon, moneyObj:FindFirstChild("Icon"))
        
        if moneyObj:IsA("TextLabel") then
            moneyValText = moneyObj.Text
        elseif moneyObj:FindFirstChild("TextLabel") then
            moneyValText = moneyObj.TextLabel.Text
        elseif moneyObj:FindFirstChild("Value") then
            local val = moneyObj.Value
            moneyValText = val:IsA("TextLabel") and val.Text or tostring(val.Value)
        else
            moneyValText = tostring(moneyObj)
        end
        
        moneyLabel.Text = (hasIcon and ": " or "") .. moneyValText
    end)

    local hasPetIcon = updateIconImage(topPetIcon, currentTopPetIconObj)
    topPetLabel.Text = (hasPetIcon and ": " or "") .. currentTopPetText

    local elapsed = tick() - startTime
    timeLabel.Text = formatTime(elapsed)
end)

