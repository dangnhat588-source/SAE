        }
    })

    pcall(function()
        requestFunc({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = payload
        })
    end)
end

local function GetFruitPwrName(fruitName)
    local cleanName = fruitName:gsub(" Fruit", "")
    return cleanName .. "-" .. cleanName
end

local function StoreAllFruits()
    local foundFruits = {}

    local function addFruit(item)
        if item:IsA("Tool") and item.Name:find("Fruit") and not notifiedFruits[item] then
            table.insert(foundFruits, item)
        end
    end

    if LocalPlayer:FindFirstChild("Backpack") then
        for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do
            addFruit(item)
        end
    end

    if LocalPlayer.Character then
        for _, item in ipairs(LocalPlayer.Character:GetChildren()) do
            addFruit(item)
        end
    end

    if getnilinstances then
        for _, object in ipairs(getnilinstances()) do
            addFruit(object)
        end
    end

    for _, fruitObj in ipairs(foundFruits) do
        if fruitObj and fruitObj.Parent then
            local fruitName = fruitObj.Name
            local pwrName = GetFruitPwrName(fruitName)
            
            notifiedFruits[fruitObj] = true
            UpdateStatus("Đang cất trái: " .. fruitName)
            
            local success = pcall(function()
                CommF:InvokeServer("StoreFruit", pwrName, fruitObj)
            end)
            
            if success then
                SendDiscordEmbed(fruitName)
                CreateDoneFile()
            end
            
            task.wait(0.3)
        end
    end
end

