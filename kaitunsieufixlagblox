local CHARACTER_COLOR = Color3.fromRGB(163, 162, 165) -- Màu nhân vật/NPC

-- ==========================================
-- 0. BIẾN BẦU TRỜI & MẶT NƯỚC THÀNH MỘT MÀU DUY NHẤT
-- ==========================================
local function optimizeEnvironment()
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("Sky") or child:IsA("Atmosphere") or child:IsA("PostEffect") then
			child:Destroy()
		end
	end
	
	local newSky = Instance.new("Sky")
	newSky.Name = "SolidColorSky"
	newSky.SkyboxBk = "rbxassetid://0"
	newSky.SkyboxDn = "rbxassetid://0"
	newSky.SkyboxFt = "rbxassetid://0"
	newSky.SkyboxLf = "rbxassetid://0"
	newSky.SkyboxRt = "rbxassetid://0"
	newSky.SkyboxUp = "rbxassetid://0"
	newSky.Parent = Lighting
	
	Lighting.Ambient = VOID_COLOR
	Lighting.OutdoorAmbient = VOID_COLOR
	Lighting.ColorShift_Bottom = VOID_COLOR
	Lighting.ColorShift_Top = VOID_COLOR

	pcall(function()
		local terrain = Workspace:FindFirstChildOfClass("Terrain")
		if terrain then
			terrain.WaterColor = VOID_COLOR
			terrain.WaterTransparency = 0
			terrain.WaterWaveSize = 0
			terrain.WaterWaveSpeed = 0
		end
	end)
end

optimizeEnvironment()

