local function SetSystemState(state)
    isSystemOn = state
    blackOverlay.Visible = state
    frame.Visible = state

    pcall(function()
        RunService:Set3dRenderingEnabled(not state)
    end)

    if state then
        toggleBtn.Text = "DMN X TMQ"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(30, 150, 70)
        toggleBtn.Position = UDim2.new(0.5, -90, 1, -65)
    else
        toggleBtn.Text = "DMN X TMQ"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(170, 50, 50)
        toggleBtn.Position = UDim2.new(1, -190, 0, 15)
    end
end

