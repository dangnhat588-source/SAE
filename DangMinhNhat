local isSystemOn = true

local function formatTime(seconds)
    local hours = math.floor(seconds / 3600)
    local mins = math.floor((seconds % 3600) / 60)
    local secs = math.floor(seconds % 60)
    return string.format("%02d:%02d:%02d", hours, mins, secs)
end

local function parseMoneyString(text)
    if not text then return 0 end
    local moneyStr = string.match(text, "%((.-)%)") or text
    moneyStr = string.gsub(moneyStr, "[%$/s%s]", "")

    local number = tonumber(string.match(moneyStr, "^[%d%.]+"))
    if not number then return 0 end

    local suffix = string.match(moneyStr, "%a+$")
    if suffix then
        suffix = string.upper(suffix)
        if suffix == "K" then number = number * 1e3
        elseif suffix == "M" then number = number * 1e6
        elseif suffix == "B" then number = number * 1e9
        elseif suffix == "T" then number = number * 1e12
        elseif suffix == "QA" then number = number * 1e15
        elseif suffix == "QI" then number = number * 1e18
        end
    end
    return number
end

local function extractMoneyOnly(rawText)
    if not rawText then return "N/A" end
    local moneyOnly = string.match(rawText, "(%$[%d%.]+%a*/s)") or string.match(rawText, "(%$[%d%.]+%a*)") or string.match(rawText, "([%d%.]+%a*/s)")
    return moneyOnly or rawText
end

local scrollingFrame = nil
task.spawn(function()
    local pGui = LocalPlayer:WaitForChild("PlayerGui", 10)
    if pGui then
        local activePets = pGui:WaitForChild("ActivePets", 10)
        if activePets then
            local activeFrame = activePets:WaitForChild("Frame", 5)
            if activeFrame then
                scrollingFrame = activeFrame:WaitForChild("ScrollingFrame", 5)
            end
        end
    end
end)

local startTime = tick()
task.spawn(function()
    local colorHue = 0
    while true do
        colorHue = colorHue + 0.01
        if colorHue > 1 then colorHue = 0 end
        local rainbowColor = Color3.fromHSV(colorHue, 1, 1)
        fpsLabel.TextColor3 = rainbowColor
        timeLabel.TextColor3 = rainbowColor
        RunService.RenderStepped:Wait()
    end
end)

local currentTopPetText = "Đang tìm..."
local currentTopPetIconId = ""

task.spawn(function()
    while task.wait(1) do
        if isSystemOn then
            if scrollingFrame then
                local maxMoney = -1
                local topPetText = "Không tìm thấy"
                local topPetIcon = ""

                for _, pet in ipairs(scrollingFrame:GetChildren()) do
                    if pet:IsA("GuiObject") then
                        local iconObj = pet:FindFirstChild("Icon") or pet:FindFirstChildWhichIsA("ImageLabel", true)
                        local textObj = pet:FindFirstChildWhichIsA("TextLabel", true)
                        
                        if textObj then
                            local moneyValue = parseMoneyString(textObj.Text)
                            if moneyValue > maxMoney then
                                maxMoney = moneyValue
                                topPetText = extractMoneyOnly(textObj.Text)
                                if iconObj and iconObj:IsA("ImageLabel") then
                                    topPetIcon = iconObj.Image
                                end
                            end
                        end
                    end
                end
                currentTopPetText = topPetText
                currentTopPetIconId = topPetIcon
            else
                currentTopPetText = "N/A"
                currentTopPetIconId = ""
            end
        end
    end
end)

local frameCount, lastUpdate = 0, tick()
RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1
    local now = tick()
    if now - lastUpdate >= 1 then
        fpsLabel.Text = string.format("FPS: %d", math.floor(frameCount / (now - lastUpdate)))
        frameCount = 0
        lastUpdate = now
    end

    if not isSystemOn then return end

    nameLabel.Text = LocalPlayer.Name

    -- Speed Icon & Text
    pcall(function()
        local speedGui = LocalPlayer.PlayerGui.HUD.GameHUD.BottomLeft.Speed
        if speedGui:FindFirstChild("Icon") and speedGui.Icon:IsA("ImageLabel") then
            speedIcon.Image = speedGui.Icon.Image
            speedIcon.Visible = true
        end
        speedLabel.Text = tostring(speedGui.Value.Text)
    end)

    -- Money Icon & Text
    pcall(function()
        local moneyGui = LocalPlayer.PlayerGui.HUD.GameHUD.BottomLeft.Money
        if moneyGui:FindFirstChild("Icon") and moneyGui.Icon:IsA("ImageLabel") then
            moneyIcon.Image = moneyGui.Icon.Image
            moneyIcon.Visible = true
        end
        speedLabel.Text = speedLabel.Text
        moneyLabel.Text = tostring(moneyGui:IsA("TextLabel") and moneyGui.Text or (moneyGui:FindFirstChildWhichIsA("TextLabel") and moneyGui:FindFirstChildWhichIsA("TextLabel").Text or "N/A"))
    end)

    -- Pet Icon & Text
    topPetLabel.Text = currentTopPetText
    if currentTopPetIconId ~= "" then
        topPetIcon.Image = currentTopPetIconId
        topPetIcon.Visible = true
    else
        topPetIcon.Visible = false
    end

    local elapsed = tick() - startTime
    timeLabel.Text = formatTime(elapsed)
end)

